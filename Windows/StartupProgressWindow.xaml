<Window x:Class="MkvToolnixAutomatisierung.Windows.StartupProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startet..."
        Width="520"
        Height="300"
        MinWidth="480"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="#F3F4F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18"
                   FontWeight="SemiBold"
                   Text="Werkzeuge werden vorbereitet" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText, Mode=OneWay}" />

        <!-- Details consume only the remaining height; progress must stay visible. -->
        <ScrollViewer x:Name="DetailScroller" Grid.Row="2" Margin="0,6,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock
                   Foreground="#44515D"
                   TextWrapping="Wrap"
                   Text="{Binding DetailText, Mode=OneWay}" />
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="StartupProgressBar" Grid.Column="0"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />

            <TextBlock Grid.Column="1"
                       Width="126"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="#44515D"
                       Text="{Binding ProgressText, Mode=OneWay}"
                       ToolTip="Fortschritt des aktuell bezeichneten Vorgangs." />
        </Grid>
    </Grid>
</Window>

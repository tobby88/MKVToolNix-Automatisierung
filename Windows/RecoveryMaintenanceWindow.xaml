<Window x:Class="MkvToolnixAutomatisierung.Windows.RecoveryMaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arbeitsreste und Wiederherstellung" Width="1000" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Bekannte Arbeitsreste prüfen. Nichts wird automatisch entfernt; alte MediathekView-Ordner können Einstellungen und Downloads enthalten." TextWrapping="Wrap" />
            <WrapPanel x:Name="ScanButtons" Margin="0,8,0,0">
                <Button Content="Werkzeuge prüfen" Padding="10,6" Margin="0,0,8,0" Click="Tools_Click" />
                <Button Content="IMDb-Arbeitsreste prüfen" Padding="10,6" Margin="0,0,8,0" Click="Imdb_Click" />
                <Button Content="Anderen Ordner prüfen..." Padding="10,6" Click="Choose_Click" />
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="EntriesGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Selection_Changed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="200" />
                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="Geändert (UTC)" Binding="{Binding LastWriteUtc, StringFormat=g}" Width="145" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Margin="0,10" Text="{Binding SelectedItem.Hint, ElementName=EntriesGrid}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3">
            <WrapPanel>
                <Button x:Name="OpenButton" Content="Im Explorer zeigen" IsEnabled="False" Padding="10,6" Margin="0,0,8,0" Click="Open_Click" />
                <Button x:Name="RestoreButton" Content="Metadatensicherung wiederherstellen" IsEnabled="False" Padding="10,6" Margin="0,0,8,0" Click="Restore_Click" />
                <Button x:Name="RecycleButton" Content="In den Papierkorb" IsEnabled="False" Padding="10,6" Click="Recycle_Click" />
                <Button x:Name="CancelScanButton" Content="Prüfung abbrechen" IsEnabled="False" Padding="10,6" Margin="8,0,0,0" Click="Cancel_Click" />
            </WrapPanel>
            <ScrollViewer MaxHeight="90" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusText" Text="Bitte einen Prüfbereich wählen." TextWrapping="Wrap" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
